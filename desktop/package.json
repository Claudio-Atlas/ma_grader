{
  "name": "ma-grader-desktop",
  "version": "0.1.3",
  "description": "MA Grader — drag-and-drop autograder for MAT-144 spreadsheet assignments",
  "author": "Clayton Ragsdale",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "freeze:engine": "cd .. && pyinstaller --noconfirm --distpath desktop/engine --workpath desktop/build/pyi engine.spec",
    "dist:mac": "npm run build:ui && npm run freeze:engine && electron-builder --mac",
    "dist:win": "npm run build:ui && npm run freeze:engine && electron-builder --win",
    "app": "bash ./build-app.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.claytonragsdale.magrader",
    "productName": "MA Grader",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      { "from": "engine/ma-grader-engine", "to": "engine/ma-grader-engine", "filter": ["**/*"] }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": ["dmg", "dir"],
      "identity": null
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MA-Grader-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  }
}
